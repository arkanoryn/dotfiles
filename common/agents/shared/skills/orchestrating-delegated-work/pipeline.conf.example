# pipeline.conf example — DAG + per-provider slot pools
#
# This file goes in the tasks folder alongside common-understanding.md.
# If it exists, the script uses DAG mode. If absent, the script falls back
# to the SEQUENTIAL_AGENTS array in the script.
#
# To adapt for your project: edit the provider functions (how each
# provider is invoked), set SLOTS (concurrent agents per provider), and
# write your PIPELINE (the DAG).
#
# ---------------------------------------------------------------------------
# Provider functions
# ---------------------------------------------------------------------------
# Each function is the "how do I invoke this provider" recipe. It takes
# 3 args from the script: <task_file> <common_understanding_file> <prompt>.
# The function should read $THINKING_LEVEL (exported by the script) and
# pass it to the tool's reasoning flag, if any.
# Replace the body with the actual command for your tooling.
#
# Examples (uncomment the ones you need, or write your own):

# minimax via pi (accepts --thinking)
provider_minimax() {
  pi --provider minimax --model minimax-m3 \
    --thinking "${THINKING_LEVEL:-medium}" \
    -p "@$1" -p "@$2" -p "$3"
}

# mistral via vibe (thinking level set in the app, not via flag)
provider_mistral() {
  vibe -p "$3"
}

# gpt-5.5 (reviewer/fixer) via pi + openai-codex
provider_gpt() {
  pi --provider openai-codex --model gpt-5.5 \
    --thinking "${THINKING_LEVEL:-medium}" \
    -p "@$1" -p "@$2" -p "$3"
}

# ---------------------------------------------------------------------------
# Slot pool
# ---------------------------------------------------------------------------
# Map of provider name → max concurrent agents for that provider.
# Example: 1 minimax + 1 mistral in parallel = 2 agents total at most.

SLOTS=(
  [minimax]=1
  [mistral]=1
  [gpt]=1
)

# ---------------------------------------------------------------------------
# Thinking level
# ---------------------------------------------------------------------------
# The script exports $THINKING_LEVEL for each agent invocation. Provider
# functions that support a thinking flag should read it.
# Default: medium. Override per-agent via THINKING_OVERRIDES below.
# Common pattern: medium for the bulk, high for reviewers + cross-cutting
# refactors, low for trivial edits if your tool supports it.

THINKING_LEVEL=medium

# Per-agent overrides. Map of agent_id → thinking level.
# Reviewers and complex refactors benefit from "high".
THINKING_OVERRIDES=(
  [r15]=high
  [r18]=high
  [r27]=high
)

# ---------------------------------------------------------------------------
# Pipeline (DAG)
# ---------------------------------------------------------------------------
# Each line: "<agent_id>:<provider>:<space-separated-deps>"
# Empty deps = runs in the first wave (no prerequisites).
# Deps can be any agent_id from above (or below — the scheduler
# computes waves from the DAG, order in the array does not matter).
#
# Example matching the test we just ran:

PIPELINE=(
  "0:minimax:"
  "1:mistral:"
  "2:minimax:"
  "3:minimax:"
  "4:mistral:"
  "r5:gpt:0 1 2 3 4"
  "6:minimax:r5"
  "7:minimax:6"
  "8:minimax:7"
  "9:minimax:8"
  "10:mistral:7"
  "11:mistral:7"
  "13:mistral:7"
  "r-batch-10-13:gpt:10 11 13"
  "r-batch-6-9:gpt:6 7 8 9"
  "r-final:gpt:r5 r-batch-10-13 r-batch-6-9"
)
